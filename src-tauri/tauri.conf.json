{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "kladd",
  "version": "../package.json",
  "identifier": "no.sklia.kladd",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "vp dev",
    "beforeBuildCommand": "vp build"
  },
  "app": {
    "windows": [
      {
        "title": "kladd",
        "width": 1100,
        "height": 750,
        "minWidth": 480,
        "minHeight": 320,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBNTU2RDY0QzVFNEM4NUMKUldSY3lPVEZaRzFWcXU1eVhNdmNRNnllZ0dUWjNzekNSamFyWkd6dGtHVWMyRVROMmp5eHdtUS8K",
      "endpoints": ["https://github.com/sklia/kladd/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
